# ==========================================
# Yomirra — Environment Variables
# Salin file ini ke .env dan isi nilainya.
# Copy this file to .env and fill in the values.
# ==========================================

# ── Database (Supabase PostgreSQL) ────────────────────────────
# Dari Supabase Dashboard → Project Settings → Database → Connection String
# From Supabase Dashboard → Project Settings → Database → Connection String

# Pooled connection (port 6543) — digunakan aplikasi
DATABASE_URL="postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Direct connection (port 5432) — digunakan Prisma migrate
DIRECT_URL="postgresql://postgres.[project-ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase client keys (dari API settings)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."

# ── Firebase (Auth & Firestore Sync) ─────────────────────────
# Dari Firebase Console → Project Settings → General → Your apps → Web app
# From Firebase Console → Project Settings → General → Your apps → Web app

NEXT_PUBLIC_FIREBASE_API_KEY="AIza..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="[project-id].firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="[project-id]"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="[project-id].firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abcdef"

# ── Redis (Upstash) ──────────────────────────────────────────
# Dari Upstash Console → Redis → Connect → Node.js (ioredis)
# From Upstash Console → Redis → Connect → Node.js (ioredis)

REDIS_URL="rediss://default:[PASSWORD]@[endpoint].upstash.io:6379"

# ── Cloudinary (Image CDN) ───────────────────────────────────
# Dari Cloudinary Dashboard
# From Cloudinary Dashboard

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="123456789"
CLOUDINARY_API_SECRET="abcdefghijk"

# ── Application ──────────────────────────────────────────────

# URL aplikasi — ganti dengan domain produksi saat deploy
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret untuk HMAC image proxy signature (minimum 32 karakter)
# Buat random string: openssl rand -hex 32
IMAGE_PROXY_SECRET="ganti-dengan-random-string-panjang-minimal-32-karakter"