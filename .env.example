# ==========================================
# Yomirra — Environment Variables
# Copy this file to .env and fill in the values
# ==========================================

# ── Application ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Required for signed image proxying in production. Without it, images fall back to direct URLs.\nIMAGE_PROXY_SECRET="your-32-character-minimum-secret-string-here"

# ── Firebase (Auth & Storage) ────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Redis Cache (Upstash) ────────────────────────────────────
REDIS_URL="redis://localhost:6379"

TELEGRAM_BOT_TOKEN= 
TELEGRAM_CHAT_ID=   
TELEGRAM_ALLOWED_CHAT_IDS=  
TELEGRAM_WEBHOOK_SECRET=    
OPS_CRON_SECRET=
VERCEL_DEPLOY_SECRET=

# ── Search Intelligence (optional) ──────────────────────────
# Enables semantic ranking and related-title embeddings.
GEMINI_API_KEY=""
