generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  library   LibraryItem[]
  history   HistoryItem[]
}

enum Role {
  USER
  ADMIN
}

model LibraryItem {
  id        String   @id @default(cuid())
  userId    String
  mangaId   String
  sourceId  String
  title     String
  coverUrl  String?
  status    String?
  addedAt   DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId, sourceId])
  @@index([userId])
}

model HistoryItem {
  id          String   @id @default(cuid())
  userId      String
  mangaId     String
  sourceId    String
  chapterId   String
  chapterNum  Float
  page        Int      @default(0)
  progress    Float    @default(0)
  readAt      DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, mangaId, sourceId])
  @@index([userId])
}

model MangaCache {
  id          String   @id // Formatted as "sourceId:mangaId"
  sourceId    String
  mangaId     String
  data        Json     // Stores the full manga detail payload
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime

  @@index([sourceId])
}

model SourceState {
  id          String   @id // e.g., "shinigami"
  name        String
  isEnabled   Boolean  @default(true)
  version     String
  settings    Json?    // Optional source-specific settings
  updatedAt   DateTime @updatedAt
}
